# Copier en .env et remplacer les trois mots de passe
MYSQL_DATABASE=spip
MYSQL_USER=spip
MYSQL_PASSWORD=REMPLACER_PAR_UN_SECRET_LONG
MYSQL_ROOT_PASSWORD=REMPLACER_PAR_UN_AUTRE_SECRET_LONG
SPIP_SITE_NAME=Jeunesse Libertaire
SPIP_SITE_ADDRESS=http://localhost:8088
WEB_BIND=127.0.0.1
WEB_PORT=8088
SPIP_ADMIN_LOGIN=admin
SPIP_ADMIN_NAME=Admin
SPIP_ADMIN_EMAIL=admin@localhost
SPIP_ADMIN_PASSWORD=REMPLACER_PAR_UN_SECRET_LONG

# Paramètres SMTP / Envoi de courriels (activation du relai sécurisé)
# Configurer les identifiants de votre serveur de messagerie (ex: Postfix, Mailcow, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=tls
SMTP_FROM=contact@jeunesselibertaire.org
SMTP_FROM_NAME=Jeunesse Libertaire
